<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/soft_purple"
    android:fillViewport="true"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Set Your Preferences"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/primary_purple"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Language (Mandatory) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Preferred Languages (Required)"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">
            <CheckBox android:id="@+id/chkEn" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="English" android:textColor="@color/black"/>
            <CheckBox android:id="@+id/chkFa" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Persian" android:textColor="@color/black" />
        </LinearLayout>

        <!-- Liked Genres -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Genres I Like" android:textStyle="bold" android:textColor="@color/black" android:layout_marginTop="8dp"/>
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Search genres..." app:boxStrokeColor="@color/primary_purple" app:hintTextColor="@color/primary_purple">
            <AutoCompleteTextView android:id="@+id/actvLikedGenres" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:textColor="@color/black" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:id="@+id/tvSelectedLikedGenres" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Selected: None" android:textSize="12sp" android:textColor="@color/primary_blue" android:layout_marginBottom="16dp"/>

        <!-- Liked Authors -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Authors I Like" android:textStyle="bold" android:textColor="@color/black"/>
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Search authors..." app:boxStrokeColor="@color/primary_purple" app:hintTextColor="@color/primary_purple">
            <AutoCompleteTextView android:id="@+id/actvLikedAuthors" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:textColor="@color/black" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:id="@+id/tvSelectedLikedAuthors" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Selected: None" android:textSize="12sp" android:textColor="@color/primary_blue" android:layout_marginBottom="16dp"/>

        <!-- Liked Books -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Books I Like" android:textStyle="bold" android:textColor="@color/black"/>
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Search books..." app:boxStrokeColor="@color/primary_purple" app:hintTextColor="@color/primary_purple">
            <AutoCompleteTextView android:id="@+id/actvLikedBooks" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:textColor="@color/black" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:id="@+id/tvSelectedLikedBooks" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Selected: None" android:textSize="12sp" android:textColor="@color/primary_blue" android:layout_marginBottom="16dp"/>

        <!-- Disliked Genres -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Genres I Dislike" android:textStyle="bold" android:textColor="#D32F2F" android:layout_marginTop="8dp"/>
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Search to avoid..." app:boxStrokeColor="#D32F2F" app:hintTextColor="#D32F2F">
            <AutoCompleteTextView android:id="@+id/actvDislikedGenres" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:textColor="@color/black" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:id="@+id/tvSelectedDislikedGenres" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Selected: None" android:textSize="12sp" android:textColor="#D32F2F" android:layout_marginBottom="16dp"/>

        <!-- Disliked Authors -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Authors I Dislike" android:textStyle="bold" android:textColor="#D32F2F"/>
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Search to avoid..." app:boxStrokeColor="#D32F2F" app:hintTextColor="#D32F2F">
            <AutoCompleteTextView android:id="@+id/actvDislikedAuthors" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:textColor="@color/black" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:id="@+id/tvSelectedDislikedAuthors" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Selected: None" android:textSize="12sp" android:textColor="#D32F2F" android:layout_marginBottom="16dp"/>

        <!-- Disliked Books -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Books I Dislike" android:textStyle="bold" android:textColor="#D32F2F"/>
        <com.google.android.material.textfield.TextInputLayout style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Search to avoid..." app:boxStrokeColor="#D32F2F" app:hintTextColor="#D32F2F">
            <AutoCompleteTextView android:id="@+id/actvDislikedBooks" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="text" android:textColor="@color/black" />
        </com.google.android.material.textfield.TextInputLayout>
        <TextView android:id="@+id/tvSelectedDislikedBooks" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Selected: None" android:textSize="12sp" android:textColor="#D32F2F" android:layout_marginBottom="16dp"/>

        <!-- Buttons -->
        <Button
            android:id="@+id/btnSaveAndRecommend"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save &amp; Get Recommendations"
            android:backgroundTint="@color/primary_purple"
            android:textColor="@color/white"
            android:layout_marginTop="16dp" />

        <!-- Logout / Cancel Option -->
        <TextView
            android:id="@+id/tvCancelAndLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cancel and Logout"
            android:textSize="14sp"
            android:textColor="#D32F2F"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true" />

        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"
            android:indeterminateTint="@color/primary_purple"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>